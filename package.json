{
  "name": "studioflow-backend",
  "private": true,
  "version": "1.0.0",
  "description": "StudioFlow backend — Supabase Edge Functions (serverless)",
  "scripts": {
    "build:sdk": "pnpm --filter studioflow-sdk build",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.base.json"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "workspace": true
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
